{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "elite-availability-tracker",
	"main": "worker/index.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "elite-availability",
			"database_id": "69ad0bb3-3c61-40bf-84ef-7522de849deb",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Timezone used to work out which date "tomorrow" is
		"TIMEZONE": "Asia/Kolkata"
	},
	"observability": {
		"enabled": true
	}
}