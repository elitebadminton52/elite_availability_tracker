{
  "name": "elite-availability-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply elite-availability --local",
    "db:migrate:remote": "wrangler d1 migrations apply elite-availability --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5",
    "wrangler": "^4.156.1"
  }
}
